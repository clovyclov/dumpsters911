---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Commercial Dumpster Rentals Metro Detroit | Roll Off Containers"
  description="Commercial roll-off dumpster rentals in Metro Detroit. Heavy-duty 15, 20, 30 & 40 yard containers for retail, office, property managers & commercial sites."
  canonical="https://dumpsters911.com/commercial-dumpster-rentals/"
  activePage="services"
>
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="banner-pill">Commercial Waste Solutions</span>

        <h1 class="hero-title">
          Commercial Dumpster Rentals In Metro Detroit
        </h1>

        <p style="font-size:1.15rem; color:#e2e8f0; margin-bottom:25px;">
          Heavy-duty roll-off containers engineered for retail strip centers, office renovations, industrial sites, and property management cleanouts.
        </p>

        <ul class="hero-features">
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Scheduled swap-out & empty service</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Heavy-duty 15, 20, 30 & 40 yard capacity</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Direct billing options for business accounts</li>
        </ul>

        <a href="/book-now/" class="btn btn-red">Reserve Commercial Dumpster</a>
      </div>

      <div class="hero-image-wrapper">
        <img src="/assets/images/dumpsters911-banner.jpg" alt="Commercial Dumpster Rental Metro Detroit">
      </div>
    </div>
  </section>

  <!-- ==================== PRICING / SIZES SECTION (ALL 4 SIZES) ==================== -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Commercial Dumpster Sizes</div>
        <h2 class="section-title">Select Your Commercial Container Size</h2>
      </div>

      <div class="pricing-grid">
        <!-- 15 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">15 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$399</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="15 Yard Commercial Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Small office cleanouts & retail waste</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Tight alleyway or commercial parking access</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 15 Yard</a></div>
        </div>

        <!-- 20 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">20 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$450</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="20 Yard Commercial Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Retail store interior remodels</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Office furniture & document purges</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 20 Yard</a></div>
        </div>

        <!-- 30 Yard -->
        <div class="pricing-card popular-card">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">30 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$500</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="30 Yard Commercial Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Large commercial renovations</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Property manager apartment turnovers</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-red btn-block">Rent 30 Yard</a></div>
        </div>

        <!-- 40 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">40 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$650</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="40 Yard Commercial Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Major commercial demolition</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Industrial facility build-outs</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 40 Yard</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== LOCAL GEO SERVICE AREA SECTION ==================== -->
  <section class="seo-section-cream">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Commercial Service Coverage</div>
        <h2 class="section-title">Commercial Dumpster Rental Service Cities</h2>
      </div>

      <div class="geo-city-grid">
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Detroit, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Troy, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Royal Oak, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Sterling Heights, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Warren, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Livonia, MI</div>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIALS SECTION ==================== -->
  <TestimonialSlider />

  <!-- ==================== QUOTE FORM SECTION ==================== -->
  <section class="quote-section" id="get-started">
    <div class="container quote-grid">
      <div class="quote-info">
        <div class="section-subtitle">Commercial Waste Experts</div>
        <h2 class="section-title">Get Commercial Waste Scheduled Right On Time</h2>
        <p class="quote-desc">Need ongoing swaps or multi-container site rentals? Fill out the form or call (248) 479-3667.</p>
      </div>

      <div class="quote-form-card">
        <form id="quoteForm">
          <div class="form-group"><label class="form-label" for="name">Your Name <span>*</span></label><input type="text" id="name" class="form-input" required placeholder="John Doe"></div>
          <div class="form-group"><label class="form-label" for="phone">Phone Number <span>*</span></label><input type="tel" id="phone" class="form-input" required placeholder="(313) 505-8282"></div>
          <div class="form-group"><label class="form-label" for="city">City <span>*</span></label><input type="text" id="city" name="city" class="form-input" required placeholder="e.g. Detroit, Livonia, Canton"></div>

          <!-- Anti-Spam Honeypot & Turnstile -->
          <input type="text" name="company_fax" style="display:none !important; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAERzCayg0G9M4fKH" data-theme="light" data-appearance="interaction-only" style="margin: 15px 0 10px;"></div>

          <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:15px;">Get Commercial Dumpster Quote</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
