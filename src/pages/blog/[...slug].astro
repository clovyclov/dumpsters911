---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DumpsterSizeCalculator from '../../components/DumpsterSizeCalculator.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../../content/posts/*.md');
  return posts.map((post) => {
    const slug = post.file.split('/').pop()?.replace('.md', '') || '';
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = post;
const { title, description, pubDate, author, heroImage, category } = post.frontmatter;

function formatDate(dateStr: string) {
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
  return new Date(dateStr).toLocaleDateString('en-US', options);
}
---

<BaseLayout
  title={`${title} | Dumpsters 911 Blog`}
  description={description}
  canonical={`https://dumpsters911.com/blog/${Astro.params.slug}/`}
  activePage="blog"
>
  <!-- Schema.org JSON-LD Article Data & FAQ Schema -->
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": heroImage ? `https://dumpsters911.com${heroImage}` : undefined,
    "datePublished": pubDate,
    "author": {
      "@type": "Person",
      "name": author || "Moe Hammad",
      "jobTitle": "Owner & Operations Director",
      "worksFor": {
        "@type": "LocalBusiness",
        "name": "Dumpsters 911",
        "telephone": "(248) 479-3667"
      }
    },
    "publisher": {
      "@type": "Organization",
      "name": "Dumpsters 911",
      "logo": {
        "@type": "ImageObject",
        "url": "https://dumpsters911.com/assets/images/d-911-red-logo.png"
      }
    }
  })} />

  <!-- Article Container -->
  <article style="padding: 60px 0 90px; background-color: #ffffff;">
    <div class="container" style="max-width: 860px; margin: 0 auto;">
      
      <!-- Breadcrumbs -->
      <div style="font-size: 0.9rem; color: #64748b; margin-bottom: 25px; font-weight: 600;">
        <a href="/" style="color: #64748b; text-decoration: none;">Home</a> &nbsp;›&nbsp;
        <a href="/blog/" style="color: #64748b; text-decoration: none;">Blog</a> &nbsp;›&nbsp;
        <span style="color: var(--primary-red);">{category || 'Article'}</span>
      </div>

      <!-- Title & Header -->
      <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--text-dark); line-height: 1.25; margin-bottom: 20px;">
        {title}
      </h1>

      <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 30px; font-size: 0.95rem; color: #64748b; border-bottom: 2px solid #e2e8f0; padding-bottom: 20px;">
        <span style="font-weight: 800; color: var(--primary-red); text-transform: uppercase;">{category || 'Guide'}</span>
        <span>•</span>
        <span>{formatDate(pubDate)}</span>
        <span>•</span>
        <span>By {author || 'Moe Hammad (Owner & Operations Director)'}</span>
      </div>

      {heroImage && (
        <div style="margin-bottom: 40px; border: 3.5px solid #000; box-shadow: 8px 8px 0px #000; border-radius: var(--radius-lg); overflow: hidden;">
          <img src={heroImage} alt={title} style="width: 100%; max-height: 440px; object-fit: cover; display: block;" />
        </div>
      )}

      <!-- Article Body Content -->
      <div class="markdown-body" style="font-size: 1.1rem; line-height: 1.75; color: #334155;">
        <Content />
      </div>

      <!-- Interactive Calculator Tool -->
      <DumpsterSizeCalculator />

      <!-- Owner Author Bio Card -->
      <div style="background: #ffffff; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; border-radius: var(--radius-lg); padding: 25px; margin-top: 50px; display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
        <div style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; border: 2.5px solid #000; flex-shrink: 0; background: var(--bg-cream);">
          <img src="/assets/images/testimonial-owner.png" alt="Moe Hammad - Owner Dumpsters 911" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <div style="flex: 1; min-width: 240px;">
          <div style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: var(--primary-red); letter-spacing: 0.5px;">Article Author & Local Dispatch Manager</div>
          <h4 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; color: var(--text-dark); margin: 4px 0 8px;">Moe Hammad</h4>
          <p style="font-size: 0.95rem; color: #475569; margin: 0; line-height: 1.5;">
            Moe is the owner and operations director of <strong>Dumpsters 911</strong>. He personally manages dumpster dispatching across Wayne, Oakland, and Macomb counties, ensuring every customer gets driveway-safe delivery with zero hidden fees.
          </p>
        </div>
      </div>

      <!-- Call To Action Lead Card -->
      <div style="background: var(--bg-cream); border: 3.5px solid #000000; box-shadow: 8px 8px 0px #000000; border-radius: var(--radius-lg); padding: 32px 28px; margin-top: 40px; text-align: center;">
        <h3 style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 900; color: var(--text-dark); margin-bottom: 10px;">
          Need A Roll-Off Dumpster Delivered In Metro Detroit?
        </h3>
        <p style="font-size: 1.05rem; color: #475569; margin-bottom: 25px; max-width: 600px; margin-left: auto; margin-right: auto;">
          Lock in guaranteed flat-rate pricing with zero hidden fees and driveway protection. Same-day & next-day delivery available.
        </p>
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
          <a href="/book-now/" class="btn btn-green" style="font-size: 1.05rem; padding: 14px 28px;">Reserve Dumpster Online</a>
          <a href="tel:248-479-3667" class="btn btn-red" style="font-size: 1.05rem; padding: 14px 28px;">Call Moe at (248) 479-3667</a>
        </div>
      </div>

    </div>
  </article>

  <style is:global>
    /* Styling for rendered markdown content in articles */
    .markdown-body h2 {
      font-family: var(--font-heading);
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--text-dark);
      margin: 40px 0 16px;
      line-height: 1.3;
    }

    .markdown-body h3 {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--text-dark);
      margin: 30px 0 14px;
    }

    .markdown-body p {
      margin-bottom: 20px;
    }

    .markdown-body ul, .markdown-body ol {
      margin-bottom: 24px;
      padding-left: 24px;
    }

    .markdown-body li {
      margin-bottom: 10px;
    }

    .markdown-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 30px 0;
      font-size: 1rem;
      border: 3px solid #000000;
      box-shadow: 4px 4px 0px #000000;
    }

    .markdown-body th, .markdown-body td {
      border: 2px solid #000000;
      padding: 12px 15px;
      text-align: left;
    }

    .markdown-body th {
      background-color: #f1f5f9;
      font-family: var(--font-heading);
      font-weight: 800;
    }

    .markdown-body blockquote {
      border-left: 4px solid var(--primary-red);
      background: #f8fafc;
      padding: 18px 22px;
      margin: 25px 0;
      border-radius: 0 8px 8px 0;
      font-style: italic;
      color: #334155;
      border: 2.5px solid #000;
      border-left: 6px solid var(--primary-red);
      box-shadow: 4px 4px 0px #000;
    }

    .markdown-body img {
      width: 100%;
      border-radius: 12px;
      border: 3px solid #000;
      box-shadow: 6px 6px 0px #000;
      margin: 25px 0;
    }
  </style>
</BaseLayout>
