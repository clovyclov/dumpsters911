---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Roll Off Dumpster Rentals In Metro Detroit | Dumpsters 911"
  description="Fast, reliable dumpster rentals in Metro Detroit. Residential & Commercial roll off dumpsters with same day delivery & flat rates. Call 248-479-3667."
  canonical="https://dumpsters911.com/"
  activePage="home"
>
  <!-- Structured Data JSON-LD Schema -->
  <script type="application/ld+json" slot="head" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "@id": "https://dumpsters911.com/#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "item": {
              "@id": "https://dumpsters911.com/",
              "name": "Home"
            }
          }
        ]
      },
      {
        "@type": "LocalBusiness",
        "@id": "https://dumpsters911.com/#organization",
        "name": "Dumpsters 911",
        "url": "https://dumpsters911.com/",
        "logo": "https://dumpsters911.com/assets/images/d-911-red-logo.png",
        "image": "https://dumpsters911.com/assets/images/hero-skyline-bg.png",
        "telephone": "+1-248-479-3667",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "addressRegion": "MI",
          "addressCountry": "US"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5.0",
          "reviewCount": "138",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
    ]
  }
  </script>

  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="rating-badge">
          <div class="stars">★★★★★</div>
          <span class="rating-text">5.0 AVERAGE ON GOOGLE REVIEWS</span>
        </div>

        <h1 class="hero-title">
          Michigan Dumpster Rentals With Same-Day Delivery
        </h1>

        <ul class="hero-features">
          <li>
            <div class="check-icon">
              <svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg>
            </div>
            <div>Simple and seamless rental process</div>
          </li>
          <li>
            <div class="check-icon">
              <svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg>
            </div>
            <div>Both Residential & Commercial rentals</div>
          </li>
          <li>
            <div class="check-icon">
              <svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg>
            </div>
            <div>Reliable Same Day, On-Time Delivery</div>
          </li>
        </ul>

        <a href="/book-now/" class="btn btn-red">Schedule Your Dumpster</a>
      </div>

      <div class="hero-image-wrapper">
        <img src="/assets/images/dumpsters911-banner.jpg" alt="Dumpster delivery truck in Michigan">
      </div>
    </div>
  </section>

