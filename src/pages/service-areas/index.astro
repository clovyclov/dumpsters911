---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Dumpster Rental Service Areas | Metro Detroit & Local MI Cities"
  description="View all roll-off dumpster rental service areas across Metro Detroit and surrounding Michigan communities. Local flat-rate delivery in Novi, Detroit, Van Buren Twp, Pontiac & more."
  canonical="https://dumpsters911.com/service-areas/"
  activePage="services"
>
  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section" style="padding: 55px 0 70px; background: #0f172a;">
    <div class="container" style="max-width: 1100px;">
      <div style="text-align: center; max-width: 820px; margin: 0 auto;">
        <div class="rating-badge" style="margin-bottom: 18px; display: inline-flex;">
          <span class="stars" style="color: var(--star-gold);">★★★★★</span>
          <span style="font-weight: 800; font-size: 0.9rem;">800+ Deliveries across MI</span>
        </div>

        <h1 class="hero-title" style="line-height: 1.15; margin-bottom: 18px; color: #ffffff;">
          Local Michigan Roll-Off Dumpster Service Areas
        </h1>

        <p style="font-size: 1.15rem; color: #cbd5e1; margin-bottom: 25px; line-height: 1.6;">
          Dumpsters 911 provides transparent, flat-rate roll-off dumpster rentals across Wayne County, Oakland County, and Macomb County. Select your city below for local rates, delivery timelines, and size options.
        </p>

        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
          <a href="tel:248-479-3667" class="btn btn-red" style="font-size: 1.1rem; padding: 14px 28px;">Call (248) 479-3667</a>
          <a href="/book-now/" class="btn btn-white" style="font-size: 1.05rem; padding: 14px 24px;">Book Online Now</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CITIES GRID SECTION ==================== -->
  <section style="padding: 75px 0; background: #ffffff;">
    <div class="container" style="max-width: 1100px;">
      <div class="section-header">
        <div class="section-subtitle">Local Delivery Hubs</div>
        <h2 class="section-title">Select Your City</h2>
        <p style="font-size: 1.05rem; color: #475569; max-width: 720px; margin: 12px auto 0;">
          All local dumpster rentals include delivery, pickup, generous weight allowances, and rubber-wheel driveway protection.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; margin-top: 40px;">
        
        <!-- Novi, MI -->
        <div style="background: #f8fafc; border: 2.5px solid #000; box-shadow: 5px 5px 0px #000; border-radius: 12px; padding: 30px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.45rem; font-weight: 800; margin-bottom: 10px; color: var(--text-dark);">
            Novi, MI Dumpster Rentals
          </h3>
          <p style="font-size: 0.98rem; color: #475569; line-height: 1.6; margin-bottom: 20px;">
            Driveway-safe roll-off dumpsters in Novi (48374, 48375, 48377). Serving Chase Farms, Island Lake, Twelve Oaks area, and Grand River Avenue.
          </p>
          <a href="/novi-mi/" class="btn btn-outline btn-block">View Novi Rates & Sizes →</a>
        </div>

        <!-- Detroit, MI -->
        <div style="background: #f8fafc; border: 2.5px solid #000; box-shadow: 5px 5px 0px #000; border-radius: 12px; padding: 30px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.45rem; font-weight: 800; margin-bottom: 10px; color: var(--text-dark);">
            Detroit, MI Dumpster Rentals
          </h3>
          <p style="font-size: 0.98rem; color: #475569; line-height: 1.6; margin-bottom: 20px;">
            Same-day roll-off delivery across Detroit neighborhoods. Serving Corktown, Midtown, Boston-Edison, New Center, Rosedale Park, and job sites.
          </p>
          <a href="/detroit-mi/" class="btn btn-red btn-block">View Detroit Rates & Sizes →</a>
        </div>

        <!-- Van Buren Twp, MI -->
        <div style="background: #f8fafc; border: 2.5px solid #000; box-shadow: 5px 5px 0px #000; border-radius: 12px; padding: 30px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.45rem; font-weight: 800; margin-bottom: 10px; color: var(--text-dark);">
            Van Buren Twp, MI Dumpster Rentals
          </h3>
          <p style="font-size: 0.98rem; color: #475569; line-height: 1.6; margin-bottom: 20px;">
            Home dispatch location (10574 Oak Lane). Fast delivery across Belleville Lake, Belleville Road, Rawsonville, Ecorse, and Michigan Avenue.
          </p>
          <a href="/van-buren-mi/" class="btn btn-red btn-block">View Van Buren Rates & Sizes →</a>
        </div>

        <!-- Pontiac, MI -->
        <div style="background: #f8fafc; border: 2.5px solid #000; box-shadow: 5px 5px 0px #000; border-radius: 12px; padding: 30px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.45rem; font-weight: 800; margin-bottom: 10px; color: var(--text-dark);">
            Pontiac, MI Dumpster Rentals
          </h3>
          <p style="font-size: 0.98rem; color: #475569; line-height: 1.6; margin-bottom: 20px;">
            Heavy-duty residential and commercial roll-off dumpsters in Pontiac (48340, 48341, 48342). Serving Woodward Ave, M-59 corridor, and Seminole Hills.
          </p>
          <a href="/pontiac-mi/" class="btn btn-outline btn-block">View Pontiac Rates & Sizes →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== COUNTIES COVERED SECTION ==================== -->
  <section style="padding: 70px 0; background: var(--bg-cream); border-top: 3px solid #000;">
    <div class="container" style="max-width: 1050px;">
      <div class="section-header">
        <div class="section-subtitle">Regional Reach</div>
        <h2 class="section-title">Counties We Serve</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 35px;">
        <div style="background: #ffffff; border: 2.5px solid #000; box-shadow: 4px 4px 0px #000; border-radius: 10px; padding: 25px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; margin-bottom: 10px;">Wayne County</h3>
          <p style="font-size: 0.94rem; color: #475569; line-height: 1.6; margin: 0;">
            Detroit, Van Buren Township, Belleville, Canton, Livonia, Westland, Taylor, Romulus, Dearborn, and surrounding Wayne communities.
          </p>
        </div>

        <div style="background: #ffffff; border: 2.5px solid #000; box-shadow: 4px 4px 0px #000; border-radius: 10px; padding: 25px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; margin-bottom: 10px;">Oakland County</h3>
          <p style="font-size: 0.94rem; color: #475569; line-height: 1.6; margin: 0;">
            Novi, Pontiac, Farmington Hills, Southfield, Troy, Royal Oak, Rochester Hills, Commerce, and surrounding Oakland communities.
          </p>
        </div>

        <div style="background: #ffffff; border: 2.5px solid #000; box-shadow: 4px 4px 0px #000; border-radius: 10px; padding: 25px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; margin-bottom: 10px;">Macomb County</h3>
          <p style="font-size: 0.94rem; color: #475569; line-height: 1.6; margin: 0;">
            Warren, Sterling Heights, Clinton Township, Roseville, Saint Clair Shores, Shelby Township, and surrounding Macomb communities.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIAL SLIDER ==================== -->
  <TestimonialSlider />

  <!-- ==================== BOTTOM QUOTE FORM ==================== -->
  <section class="quote-section" id="get-started">
    <div class="container quote-grid">
      <div class="quote-info">
        <div class="stars" style="color:var(--star-gold); margin-bottom:10px;">★★★★★</div>
        <div class="section-subtitle">Local Michigan Dispatch</div>
        <h2 class="section-title">Schedule Your Roll-Off Delivery Today</h2>
        <p class="quote-desc" style="font-size: 1.1rem; color: #ffffff; line-height: 1.6; margin-top: 15px;">
          Need a dumpster delivered to your driveway or commercial site? Fill out the quote form or call us directly for same-day dispatch.
        </p>
        <div style="margin-top: 25px;">
          <a href="tel:248-479-3667" class="btn btn-red" style="font-size: 1.05rem; padding: 14px 26px;">Call (248) 479-3667</a>
        </div>
      </div>

      <div class="quote-form-card">
        <h3>Get A Fast Local Dumpster Quote</h3>
        <p>Flat-rate pricing with drop-off, haul-away, and weight included. No hidden fees.</p>

        <form id="quoteForm">
          <div class="form-group">
            <label class="form-label" for="nameBottom">Your Name <span>*</span></label>
            <input type="text" id="nameBottom" class="form-input" required placeholder="John Doe">
          </div>

          <div class="form-group">
            <label class="form-label" for="phoneBottom">Phone Number <span>*</span></label>
            <input type="tel" id="phoneBottom" class="form-input" required placeholder="(313) 505-8282">
          </div>

          <div class="form-group">
            <label class="form-label" for="cityBottom">City / Location <span>*</span></label>
            <input type="text" id="cityBottom" name="city" class="form-input" required placeholder="e.g. Belleville, Novi, Detroit, Pontiac">
          </div>

          <div class="form-group">
            <label class="form-label">What size dumpster do you need? <span>*</span></label>
            <div class="radio-group">
              <div class="radio-btn-option">
                <input type="radio" id="size15Bottom" name="dumpster_size" value="15 Yard" required>
                <label for="size15Bottom">15 Yard</label>
              </div>
              <div class="radio-btn-option">
                <input type="radio" id="size20Bottom" name="dumpster_size" value="20 Yard">
                <label for="size20Bottom">20 Yard</label>
              </div>
              <div class="radio-btn-option">
                <input type="radio" id="size30Bottom" name="dumpster_size" value="30 Yard">
                <label for="size30Bottom">30 Yard</label>
              </div>
              <div class="radio-btn-option">
                <input type="radio" id="size40Bottom" name="dumpster_size" value="40 Yard">
                <label for="size40Bottom">40 Yard</label>
              </div>
              <div class="radio-btn-option">
                <input type="radio" id="sizeNotsureBottom" name="dumpster_size" value="Not Sure">
                <label for="sizeNotsureBottom">Not sure</label>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">How soon do you need delivery? <span>*</span></label>
            <div class="radio-group">
              <div class="radio-btn-option">
                <input type="radio" id="timeTodayBottom" name="how_soon" value="Today" required>
                <label for="timeTodayBottom">Today</label>
              </div>
              <div class="radio-btn-option">
                <input type="radio" id="time3DaysBottom" name="how_soon" value="Within 3 days">
                <label for="time3DaysBottom">Within 3 days</label>
              </div>
              <div class="radio-btn-option">
                <input type="radio" id="timeWeekBottom" name="how_soon" value="Within a week">
                <label for="timeWeekBottom">Within a week</label>
              </div>
              <div class="radio-btn-option">
                <input type="radio" id="timeLaterBottom" name="how_soon" value="Much later">
                <label for="timeLaterBottom">Much later</label>
              </div>
            </div>
          </div>

          <!-- Anti-Spam Honeypot & Turnstile -->
          <input type="text" name="company_fax" style="display:none !important; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAERzCayg0G9M4fKH" data-theme="light" style="margin: 15px 0 10px;"></div>

          <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:15px; font-size:1rem;">
            Get Your Dumpster Quote
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- ==================== PRE-FOOTER BANNER ==================== -->
  <section class="pre-footer-banner">
    <div class="container pre-footer-content">
      <div class="pre-footer-text">
        Ready to order a roll-off dumpster in your area? Book online in under 2 minutes.
      </div>
      <a href="/book-now/" class="btn btn-red" style="padding: 14px 28px; font-size: 1.05rem;">Book Online Today →</a>
    </div>
  </section>
</BaseLayout>
