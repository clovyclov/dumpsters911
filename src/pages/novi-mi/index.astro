  <script is:inline>
    // Hero 7-Image Slider Animation
    (function initHeroSlider() {
      const track = document.getElementById('heroSliderTrack');
      if (!track) return;
      
      const totalSlides = 7;
      let currentIndex = 0;
      
      setInterval(() => {
        currentIndex = (currentIndex + 1) % totalSlides;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }, 3500);
    })();
  </script>
