---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Roll-Off Dumpster Rental Services Metro Detroit | Dumpsters 911"
  description="Explore our full range of roll-off dumpster rental services in Metro Detroit. Residential, commercial, construction, yard waste & junk removal dumpsters with flat rates and driveway protection."
  canonical="https://dumpsters911.com/services/"
  activePage="services"
>
  <style>
    .services-overview-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
      margin-top: 40px;
    }

    .service-overview-card {
      background: #ffffff;
      border: 3px solid #000000;
      box-shadow: 6px 6px 0px #000000;
      border-radius: var(--radius-lg);
      padding: 35px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .service-overview-card:hover {
      transform: translateY(-4px);
      box-shadow: 10px 10px 0px #000000;
    }

    .service-icon-box {
      width: 60px;
      height: 60px;
      background: var(--primary-red);
      color: #ffffff;
      border: 2.5px solid #000000;
      box-shadow: 3px 3px 0px #000000;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      margin-bottom: 22px;
    }

    .service-card-title {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      font-weight: 900;
      color: var(--text-dark);
      margin-bottom: 12px;
      line-height: 1.3;
    }

    .service-card-desc {
      font-size: 0.98rem;
      color: #475569;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .service-card-list {
      list-style: none;
      padding: 0;
      margin: 0 0 25px 0;
    }

    .service-card-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-dark);
      margin-bottom: 8px;
    }

    .service-card-list li svg {
      width: 18px;
      height: 18px;
      fill: var(--green-btn);
      flex-shrink: 0;
    }

    @media (max-width: 992px) {
      .services-overview-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 650px) {
      .services-overview-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section" style="padding: 70px 0 85px;">
    <div class="container" style="max-width: 900px; text-align: center;">
      <div class="rating-badge" style="margin-bottom: 18px; margin-left: auto; margin-right: auto;">
        <span class="stars" style="color: var(--star-gold);">★★★★★</span>
        <span style="font-weight: 800; font-size: 0.9rem;">5.0 Rated Local Metro Detroit Provider</span>
      </div>

      <h1 class="hero-title" style="font-size: 2.6rem; line-height: 1.15; margin-bottom: 18px;">
        Roll-Off Dumpster Rental Services In Metro Detroit
      </h1>

      <p style="font-size: 1.15rem; color: #e2e8f0; max-width: 720px; margin: 0 auto 30px; line-height: 1.6;">
        From residential home cleanouts and roofing tear-offs to commercial retail renovations and yard waste clearing, Dumpsters 911 delivers driveway-safe containers with guaranteed on-time drop-off.
      </p>

      <div class="hero-cta-buttons" style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <a href="/book-now/" class="btn btn-green" style="font-size: 1.1rem; padding: 14px 28px;">Book Online Now</a>
        <a href="/pricing-and-sizes/" class="btn btn-white" style="font-size: 1.05rem; padding: 14px 24px;">View Pricing & Sizes</a>
      </div>
    </div>
  </section>

  <!-- ==================== ALL SERVICES OVERVIEW GRID ==================== -->
  <section style="padding: 85px 0 95px; background-color: var(--bg-cream);">
