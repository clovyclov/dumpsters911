      try {
        const params = new URLSearchParams(window.location.search);
        const tag = params.get('t') || params.get('headline') || params.get('h') || params.get('title');
        
        if (!tag || !tag.trim()) return;
        const cleanTag = tag.trim().toLowerCase();

        // Preset headline mapping for Google Ads ad groups
        const presets = {
          'residential-1': 'Residential Driveway Dumpster Rentals In Metro Detroit',
          'roofing-1': 'Fast Roofing Shingle Dumpster Rentals In Metro Detroit',
          'commercial-1': 'Commercial Roll-Off Dumpster Services In Metro Detroit',
          'yard-1': 'Yard Waste & Landscaping Dumpster Rentals In Metro Detroit',
          'junk-1': 'Junk Removal & House Cleanout Dumpster Rentals In Metro Detroit'
        };

        let targetHeadline = presets[cleanTag];

        // If not a preset, format readable custom text (replace hyphens/underscores with spaces)
        if (!targetHeadline) {
          targetHeadline = tag.replace(/[-_]+/g, ' ').trim();
          // Capitalize first letter of words if all lowercase
          if (targetHeadline === targetHeadline.toLowerCase()) {
            targetHeadline = targetHeadline.replace(/\b\w/g, c => c.toUpperCase());
          }
        }

        if (targetHeadline) {
          const headlineEl = document.getElementById('hero-headline');
          if (headlineEl) {
            headlineEl.textContent = targetHeadline;
          }
        }
      } catch (e) {
        console.log('Dynamic headline replacement error:', e);
      }
    })();
  </script>

  <!-- Client-side Dynamic Discount Headline Script -->
  <script is:inline>
    (function handleDynamicDiscount() {
      try {
        const params = new URLSearchParams(window.location.search);
        const discountParam = params.get('d') || params.get('discount') || params.get('off');
        if (!discountParam) return;

        const cleanVal = discountParam.trim();
        const validDiscounts = ['10', '15', '25'];

        if (validDiscounts.includes(cleanVal)) {
          // Show promo eyebrow badge above form headlines
          const promoBadges = document.querySelectorAll('.form-promo-badge');
          promoBadges.forEach(badge => {
            badge.textContent = 'NEW CUSTOMER SPECIAL';
            badge.style.display = 'inline-block';
          });

          // Update main headline to highlight discount amount
          const formHeadlines = document.querySelectorAll('.quote-form-card h3');
          formHeadlines.forEach(el => {
            el.textContent = `Save $${cleanVal} On Your Dumpster Rental Today`;
          });

          // Update modal title if opened
          const modalTitle = document.querySelector('.modal-card h3');
          if (modalTitle) {
            modalTitle.textContent = `Save $${cleanVal} On Your Dumpster Rental Today`;
          }

          // Update form submit button text for discount offer
          const submitBtns = document.querySelectorAll('form button[type="submit"]');
          submitBtns.forEach(btn => {
            btn.textContent = 'Claim Your Dumpster Rental Discount';
          });
        }
      } catch (e) {
        console.log('Dynamic discount script error:', e);
      }
    })();

    // Carry over URL parameters to booking and thank you links
    (function preserveUrlParams() {
      try {
        const search = window.location.search;
        if (!search) return;

        const links = document.querySelectorAll('a[href*="book-online-mi"], a[href*="book-now"], a[href*="thank-you"]');
        links.forEach(link => {
          try {
            const url = new URL(link.href, window.location.origin);
            const currentParams = new URLSearchParams(search);
            currentParams.forEach((val, key) => {
              url.searchParams.set(key, val);
            });
            link.href = url.toString();
          } catch(e){}
        });
      } catch (e) {}
    })();
  </script>

  <!-- Hero Infinite 4-Image Slider Script -->
  <script is:inline>
    (function initHeroSlider() {
      const track = document.getElementById('heroSliderTrack');
      if (!track) return;

      const slides = track.children;
      if (slides.length <= 1) return;

      let currentIndex = 0;
      const totalSlides = slides.length;

      setInterval(() => {
        currentIndex = (currentIndex + 1) % totalSlides;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }, 3500);
    })();
  </script>
</BaseLayout>
