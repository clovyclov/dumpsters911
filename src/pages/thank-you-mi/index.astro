---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Booking Confirmed | Thank You | Dumpsters 911"
  description="Thank you for renting with Dumpsters 911! Your roll-off dumpster booking has been received. Our dispatch team will contact you to confirm delivery details."
  canonical="https://dumpsters911.com/thank-you-mi/"
  noindex={true}
  hideHeader={true}
  activePage="landing"
>
  <!-- Event snippet for Dumpster Purchased conversion - Enhanced Conversions Enabled -->
  <script is:inline slot="head">
    (function() {
      var ecData = null;
      try {
        var saved = sessionStorage.getItem('d911_user_data');
        if (saved) ecData = JSON.parse(saved);
      } catch(e){}

      if (ecData && typeof gtag === 'function') {
        gtag('set', 'user_data', ecData);
      }

      var convPayload = {
        'send_to': 'AW-17518379587/57xBCPSq1akcEMOEtaFB'
      };
      if (ecData) {
        convPayload['user_data'] = ecData;
      }

      if (typeof gtag === 'function') {
        gtag('event', 'conversion', convPayload);
      }
    })();
  </script>

  <!-- ==================== PPC HEADER ==================== -->
  <header class="ppc-header">
    <div class="container ppc-header-container">
      <a href="/" class="logo-link">
        <img src="/assets/images/d-911-red-logo.png" alt="Dumpsters 911 Logo" style="max-height: 50px;">
      </a>

      <div style="display: flex; align-items: center; gap: 15px;">
        <div style="text-align: right; display: none; @media(min-width: 600px){display:block;}">
          <div style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; color: #64748b;">Need Assistance? Call Us</div>
          <a href="tel:248-479-3667" class="ppc-phone-number">(248) 479-3667</a>
        </div>
        <a href="tel:248-479-3667" class="btn btn-red" style="font-size: 1rem; padding: 12px 22px;">Call (248) 479-3667</a>
      </div>
    </div>
  </header>

  <!-- ==================== THANK YOU HERO SECTION ==================== -->
  <section style="padding: 60px 0 90px; background-color: var(--bg-cream);">
    <div class="container" style="max-width: 880px; text-align: center;">
      <div class="success-icon-circle">✓</div>

      <span class="banner-pill" style="margin-bottom: 15px;">Reservation Confirmed</span>

      <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--text-dark); text-transform: uppercase; margin-bottom: 15px; line-height: 1.2;">
        Thank You For Choosing <br>
        <span style="color: var(--primary-red);">Dumpsters 911</span>
      </h1>

      <p style="font-size: 1.15rem; color: #475569; max-width: 650px; margin: 0 auto; line-height: 1.6;">
        Your roll-off dumpster booking request has been received! Our local Metro Detroit dispatch team is preparing your order and will contact you shortly to confirm drop-off details.
      </p>

      <!-- What Happens Next Grid -->
      <div class="next-steps-grid">
        <div class="step-card">
          <span class="step-number">1</span>
          <div class="step-title">Dispatch Call</div>
          <div class="step-desc">Our team will call or text to verify your delivery time and exact driveway placement.</div>
        </div>

        <div class="step-card">
          <span class="step-number">2</span>
          <div class="step-title">On-Time Drop-Off</div>
          <div class="step-desc">We deliver your driveway-safe dumpster on schedule with rubber wheel protection.</div>
        </div>

        <div class="step-card">
          <span class="step-number">3</span>
          <div class="step-title">Easy Haul-Away</div>
          <div class="step-desc">Fill it up at your own pace and call us when ready. We take care of the rest!</div>
        </div>
      </div>

      <!-- Assistance Callout Card -->
      <div style="background: #ffffff; border: 3.5px solid #000000; box-shadow: 8px 8px 0px #000000; border-radius: var(--radius-lg); padding: 30px; margin-top: 30px; text-align: center;">
        <h3 style="font-family: var(--font-heading); font-size: 1.35rem; font-weight: 900; color: var(--text-dark); margin-bottom: 8px;">
          Need Immediate Assistance Or Delivery Modifications?
        </h3>
        <p style="font-size: 1rem; color: #475569; margin-bottom: 20px;">
          Speak directly with our local Metro Detroit team:
        </p>
        <a href="tel:248-479-3667" class="btn btn-red" style="font-size: 1.1rem; padding: 14px 28px;">
          CALL (248) 479-3667
        </a>
      </div>

    </div>
  </section>

  <!-- Sticky Mobile Call Bar -->
  <div class="sticky-call-bar">
    <a href="tel:248-479-3667" class="sticky-call-btn">
      CALL (248) 479-3667 TO TALK TO DISPATCH
    </a>
  </div>
</BaseLayout>
