  <!-- ==================== ACCEPTED TREE DEBRIS SECTION ==================== -->
  <section style="padding: 70px 0; background: #ffffff; border-top: 3px solid #000; border-bottom: 3px solid #000;">
    <div class="container" style="max-width: 1000px; margin: 0 auto;">
      <div class="section-header">
        <div class="section-subtitle">What You Can Load</div>
        <h2 class="section-title">Accepted Tree & Organic Debris</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; margin-top: 30px;">
        <div style="background: #f8fafc; border: 2.5px solid #000; box-shadow: 4px 4px 0px #000; border-radius: 10px; padding: 25px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.3rem; margin-bottom: 15px; color: #16a34a; display: flex; align-items: center; gap: 8px;">
            <span>✓</span> Accepted Tree Debris
          </h3>
          <ul style="list-style: none; padding: 0; margin: 0; line-height: 2;">
            <li>🌲 <strong>Tree Branches & Limbs</strong> (All sizes & lengths)</li>
            <li>🪵 <strong>Tree Trunks & Heavy Logs</strong></li>
            <li>🪵 <strong>Tree Stumps & Root Balls</strong></li>
            <li>🌿 <strong>Shrubs, Bushes & Hedge Trimmings</strong></li>
            <li>🍂 <strong>Leaves, Mulch & Wood Chips</strong></li>
            <li>🌱 <strong>Sod, Dirt, Soil & Landscape Rock</strong></li>
          </ul>
        </div>

        <div style="background: #f8fafc; border: 2.5px solid #000; box-shadow: 4px 4px 0px #000; border-radius: 10px; padding: 25px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.3rem; margin-bottom: 15px; color: #dc2626; display: flex; align-items: center; gap: 8px;">
            <span>✕</span> Prohibited Materials
          </h3>
          <ul style="list-style: none; padding: 0; margin: 0; line-height: 2;">
            <li>🚫 Hazardous chemicals, oil & gasoline</li>
            <li>🚫 Paints, stains & solvents</li>
            <li>🚫 Car tires & heavy automotive batteries</li>
            <li>🚫 Asbestos or toxic insulation</li>
            <li>🚫 Liquid concrete (hardened chunks allowed)</li>
            <li>🚫 Gas-powered lawn equipment with fuel tanks</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ACCORDION SECTION ==================== -->
