---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Dumpster for Tree Debris Metro Detroit | Tree Trimming & Branch Removal"
  description="Rent a roll-off dumpster for tree debris, branches, logs, stumps & storm cleanup in Metro Detroit. Flat-rate pricing starting at $399 with driveway protection & fast delivery."
  canonical="https://dumpsters911.com/dumpster-for-tree-debris/"
  activePage="services"
>
  <!-- ==================== HERO SECTION WITH CONVERSION FORM ==================== -->
  <section class="hero-section" style="padding: 50px 0 70px; background: #0f172a;">
    <div class="container">
      <div class="hero-grid" style="align-items: center;">
        
        <!-- Left Hero Offer Copy -->
        <div class="hero-offer-content">
          <div class="rating-badge" style="margin-bottom: 18px;">
            <span class="stars" style="color: var(--star-gold);">★★★★★</span>
            <span style="font-weight: 800; font-size: 0.9rem;">800+ Deliveries across MI</span>
          </div>

          <h1 id="hero-headline" class="hero-title" style="line-height: 1.15; margin-bottom: 18px;">
            Roll-Off Dumpsters For Tree Debris & Branch Removal
          </h1>

          <!-- Infinite 7-Image Dumpster Slider Under Headline -->
          <div class="hero-slider-wrapper" style="margin-bottom: 22px; border-radius: 14px; overflow: hidden; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; position: relative;">
            <div class="hero-slider-track" id="heroSliderTrack" style="display: flex; transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); width: 100%;">
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; align-items: center; justify-content: center;">
                <img 
                  src="/assets/images/dumpsters911-real-1.jpg" 
                  alt="Dumpsters 911 Jobsite Delivery 1" 
                  class="hero-slide-img"
                />
              </div>
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; align-items: center; justify-content: center;">
                <img 
                  src="/assets/images/dumpsters911-real-2.jpg" 
                  alt="Dumpsters 911 Driveway Delivery 2" 
                  class="hero-slide-img"
                />
              </div>
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; align-items: center; justify-content: center;">
                <img 
                  src="/assets/images/dumpsters911-real-3.jpg" 
                  alt="Dumpsters 911 Roll-Off Dumpster 3" 
                  class="hero-slide-img"
                />
              </div>
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; align-items: center; justify-content: center;">
                <img 
                  src="/assets/images/dumpsters911-real-4.jpg" 
                  alt="Dumpsters 911 Driveway Dumpster 4" 
                  class="hero-slide-img"
                />
              </div>
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; align-items: center; justify-content: center;">
                <img 
                  src="/assets/images/dumpsters911-real-5.jpg" 
                  alt="Dumpsters 911 Cleanout Dumpster 5" 
                  class="hero-slide-img"
                />
              </div>
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; align-items: center; justify-content: center;">
                <img 
                  src="/assets/images/dumpsters911-real-6.jpg" 
                  alt="Dumpsters 911 Construction Waste Dumpster 6" 
                  class="hero-slide-img"
                />
              </div>
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; align-items: center; justify-content: center;">
                <img 
                  src="/assets/images/dumpsters911-real-1.jpg" 
                  alt="Dumpsters 911 Heavy Roll-Off Dumpster 7" 
                  class="hero-slide-img"
                />
              </div>
            </div>
          </div>

          <p style="font-size: 1.15rem; color: #e2e8f0; margin-bottom: 25px; line-height: 1.5;">
            Tackling tree trimming, heavy branch removal, stump clearing, or storm damage in Metro Detroit? Lock in flat-rate delivery with <strong>no hidden fees</strong> and guaranteed driveway protection.
          </p>

          <ul class="hero-features" style="margin-bottom: 30px; list-style: none; padding: 0;">
            <li style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px;">
              <div class="check-icon" style="width: 22px; height: 22px; flex: 0 0 22px; min-width: 22px; min-height: 22px; display: inline-flex; align-items: center; justify-content: center;"><svg viewBox="0 0 512 512" style="width: 20px; height: 20px; flex: 0 0 20px; fill: #22c55e;"><path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z"/></svg></div>
              <div><strong>Same-Day & Next-Day Delivery</strong> Available across Metro Detroit</div>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px;">
              <div class="check-icon" style="width: 22px; height: 22px; flex: 0 0 22px; min-width: 22px; min-height: 22px; display: inline-flex; align-items: center; justify-content: center;"><svg viewBox="0 0 512 512" style="width: 20px; height: 20px; flex: 0 0 20px; fill: #22c55e;"><path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z"/></svg></div>
              <div><strong>Flat-Rate Pricing Starting at $399</strong> — Drop-off, haul-away & weight included</div>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px;">
              <div class="check-icon" style="width: 22px; height: 22px; flex: 0 0 22px; min-width: 22px; min-height: 22px; display: inline-flex; align-items: center; justify-content: center;"><svg viewBox="0 0 512 512" style="width: 20px; height: 20px; flex: 0 0 20px; fill: #22c55e;"><path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z"/></svg></div>
              <div><strong>100% Driveway Protection Guarantee</strong> with rubber wheels</div>
            </li>
          </ul>

          <div class="hero-cta-buttons" style="display: flex; gap: 15px; flex-wrap: wrap;">
            <a href="tel:248-479-3667" class="btn btn-red" style="font-size: 1.1rem; padding: 14px 28px;">Call (248) 479-3667</a>
            <a href="#pricing" class="btn btn-white" style="font-size: 1.05rem; padding: 14px 24px;">See pricing</a>
          </div>
        </div>

        <!-- Right Hero Above-The-Fold Lead Form -->
        <div class="quote-form-card" id="ppc-form">
          <div class="form-promo-badge" style="display: none;">NEW CUSTOMER SPECIAL</div>
          <h3>One Flat Price. No Hidden Fees. No Weight Surprises.</h3>
          <p>Get the best dumpster pricing today. Same-Day Delivery Available most days. Fill out the form for our latest deals.</p>

          <form id="ppcQuoteForm">
            <div class="form-group">
              <label class="form-label" for="nameHero">Your Name <span>*</span></label>
              <input type="text" id="nameHero" class="form-input" required placeholder="John Doe">
            </div>

            <div class="form-group">
              <label class="form-label" for="phoneHero">Phone Number <span>*</span></label>
              <input type="tel" id="phoneHero" class="form-input" required placeholder="(313) 505-8282">
            </div>

            <div class="form-group">
              <label class="form-label" for="cityHero">City <span>*</span></label>
              <input type="text" id="cityHero" name="city" class="form-input" required placeholder="e.g. Detroit, Livonia, Canton">
            </div>

            <div class="form-group">
              <label class="form-label">What size dumpster do you need? <span>*</span></label>
              <div class="radio-group">
                <div class="radio-btn-option">
                  <input type="radio" id="size15Hero" name="dumpster_size_hero" value="15 Yard" required>
                  <label for="size15Hero">15 Yard</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="size20Hero" name="dumpster_size_hero" value="20 Yard">
                  <label for="size20Hero">20 Yard</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="size30Hero" name="dumpster_size_hero" value="30 Yard">
                  <label for="size30Hero">30 Yard</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="size40Hero" name="dumpster_size_hero" value="40 Yard">
                  <label for="size40Hero">40 Yard</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="sizeNotsureHero" name="dumpster_size_hero" value="Not Sure">
                  <label for="sizeNotsureHero">Not sure</label>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">How soon do you need the dumpster? <span>*</span></label>
              <div class="radio-group">
                <div class="radio-btn-option">
                  <input type="radio" id="timeTodayHero" name="how_soon_hero" value="Today" required>
                  <label for="timeTodayHero">Today</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="time3DaysHero" name="how_soon_hero" value="Within 3 days">
                  <label for="time3DaysHero">Within 3 days</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="timeWeekHero" name="how_soon_hero" value="Within a week">
                  <label for="timeWeekHero">Within a week</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="timeLaterHero" name="how_soon_hero" value="Much later">
                  <label for="timeLaterHero">Much later</label>
                </div>
              </div>
            </div>

            <!-- Anti-Spam Honeypot & Turnstile -->
            <input type="text" name="company_fax" style="display:none !important; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAERzCayg0G9M4fKH" data-theme="light" style="margin: 15px 0 10px;"></div>

            <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:15px; font-size:1rem;">
              Get Your Dumpster Rental Quote
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== PRICING / SIZES SECTION ==================== -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Tree Debris Dumpster Sizes</div>
        <h2 class="section-title">Select Your Container Size</h2>
        <p style="font-size: 1.05rem; color: #475569; max-width: 720px; margin: 12px auto 0;">
          All tree debris dumpster rentals include flat-rate delivery, pickup, flexible rental duration, and complete driveway protection.
        </p>
      </div>

      <div class="pricing-grid">
        <!-- 15 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">15 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$399</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="15 Yard Tree Debris Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Small tree pruning & shrub trim</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Residential yard cleanup</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 15 Yard</a></div>
        </div>

        <!-- 20 Yard -->
        <div class="pricing-card popular-card">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">20 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$450</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="20 Yard Tree Debris Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Medium tree removal & branches</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Storm damage & fallen limbs</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-red btn-block">Rent 20 Yard</a></div>
        </div>

        <!-- 30 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">30 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$500</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="30 Yard Tree Debris Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Large tree removal & heavy logs</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Overgrown lot land clearing</li>
