  <!-- Client-side Dynamic Scripts -->
  <script is:inline>
    // Hero 7-Image Slider Animation
    (function initHeroSlider() {
      const track = document.getElementById('heroSliderTrack');
      if (!track) return;
      
      const totalSlides = 7;
      let currentIndex = 0;
      
      setInterval(() => {
        currentIndex = (currentIndex + 1) % totalSlides;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }, 3500);
    })();

    // Client-side Dynamic Discount Headline & Button Script
    (function handleDynamicDiscount() {
      try {
        const params = new URLSearchParams(window.location.search);
        const discountParam = params.get('d') || params.get('discount') || params.get('off');
        if (!discountParam) return;

        const cleanVal = discountParam.trim();
        const validDiscounts = ['10', '15', '25'];

        if (validDiscounts.includes(cleanVal)) {
          const badges = document.querySelectorAll('.form-promo-badge');
          badges.forEach(b => {
            b.style.display = 'inline-block';
            b.textContent = 'NEW CUSTOMER SPECIAL';
          });

          const forms = [document.getElementById('ppcQuoteForm'), document.getElementById('quoteForm')];
          forms.forEach(form => {
            if (!form) return;
            const card = form.closest('.quote-form-card');
            if (!card) return;

            const cardTitle = card.querySelector('h3');
            if (cardTitle) {
              cardTitle.textContent = `Save $${cleanVal} On Your Dumpster Rental Today`;
            }

            const submitBtn = card.querySelector('button[type="submit"]');
            if (submitBtn) {
              submitBtn.textContent = 'Claim Your Dumpster Rental Discount';
            }
          });
        }
      } catch (e) {
        console.log('Dynamic discount error:', e);
      }
    })();

    // Dynamic H1 Headline Replacement Script
    (function handleDynamicHeadline() {
      try {
        const params = new URLSearchParams(window.location.search);
        const tag = params.get('t') || params.get('headline') || params.get('h') || params.get('title');
        
        if (!tag || !tag.trim()) return;
        const cleanTag = tag.trim().toLowerCase();

        const presets = {
          'residential-1': 'Residential Driveway Dumpster Rentals In Metro Detroit',
          'roofing-1': 'Fast Roofing Shingle Dumpster Rentals In Metro Detroit',
          'commercial-1': 'Commercial Roll-Off Dumpster Services In Metro Detroit',
          'yard-1': 'Yard Waste & Landscaping Dumpster Rentals In Metro Detroit',
          'junk-1': 'Junk Removal & House Cleanout Dumpster Rentals In Metro Detroit'
        };

        let targetHeadline = presets[cleanTag];

        if (!targetHeadline) {
          targetHeadline = tag.replace(/[-_]+/g, ' ').trim();
          if (targetHeadline === targetHeadline.toLowerCase()) {
            targetHeadline = targetHeadline.replace(/\b\w/g, c => c.toUpperCase());
          }
        }

        if (targetHeadline) {
          const headlineEl = document.getElementById('hero-headline');
          if (headlineEl) {
            headlineEl.textContent = targetHeadline;
          }
        }
      } catch (e) {
        console.log('Dynamic headline error:', e);
      }
    })();
  </script>
