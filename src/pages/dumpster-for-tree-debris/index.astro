---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Dumpster for Tree Debris Metro Detroit | Tree Trimming & Branch Removal"
  description="Rent a roll-off dumpster for tree debris, branches, logs, stumps & storm cleanup in Metro Detroit. Flat-rate pricing starting at $399 with driveway protection & fast delivery."
  canonical="https://dumpsters911.com/dumpster-for-tree-debris/"
  activePage="services"
>
  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="banner-pill">Tree & Heavy Branch Debris</span>

        <h1 class="hero-title">
          Roll-Off Dumpsters For Tree Debris & Branch Removal
        </h1>

        <p style="font-size:1.15rem; color:#e2e8f0; margin-bottom:25px; line-height: 1.6;">
          Tackling tree trimming, heavy branch removal, stump clearing, or storm damage in Metro Detroit? Dumpsters 911 delivers driveway-safe containers with low-profile rear swing doors for easy log loading.
        </p>

        <ul class="hero-features">
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Same-day & next-day delivery across Metro Detroit</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>100% driveway protection guarantee with rubber wheels</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Flat-rate pricing including drop-off, haul-away & weight</li>
        </ul>

        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
          <a href="/book-now/" class="btn btn-red" style="font-size: 1.1rem; padding: 14px 28px;">Reserve Tree Debris Dumpster</a>
          <a href="tel:248-479-3667" class="btn btn-white" style="font-size: 1.05rem; padding: 14px 24px;">Call (248) 479-3667</a>
        </div>
      </div>

      <div class="hero-image-wrapper">
        <img src="/assets/images/dumpsters911-banner.jpg" alt="Dumpster for Tree Debris Metro Detroit">
      </div>
    </div>
  </section>

  <!-- ==================== PRICING / SIZES SECTION ==================== -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Tree Debris Dumpster Sizes</div>
        <h2 class="section-title">Select Your Container Size</h2>
        <p style="font-size: 1.05rem; color: #475569; max-width: 720px; margin: 12px auto 0;">
          All tree debris dumpster rentals include flat-rate delivery, pickup, flexible rental duration, and complete driveway protection.
        </p>
      </div>

      <div class="pricing-grid">
        <!-- 15 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">15 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$399</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="15 Yard Tree Debris Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Small tree pruning & shrub trim</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Residential yard cleanup</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 15 Yard</a></div>
        </div>

        <!-- 20 Yard -->
        <div class="pricing-card popular-card">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">20 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$450</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="20 Yard Tree Debris Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Medium tree removal & branches</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Storm damage & fallen limbs</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-red btn-block">Rent 20 Yard</a></div>
        </div>

        <!-- 30 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">30 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$500</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="30 Yard Tree Debris Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Large tree removal & heavy logs</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Overgrown lot land clearing</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 30 Yard</a></div>
        </div>

        <!-- 40 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">40 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$599</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/d911-red-dumpster.png" alt="40 Yard Tree Debris Dumpster"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Commercial tree contractor jobs</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Major storm damage clearance</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 40 Yard</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ACCEPTED TREE DEBRIS SECTION ==================== -->
  <section style="padding: 70px 0; background: #ffffff; border-top: 3px solid #000; border-bottom: 3px solid #000;">
    <div class="container" style="max-width: 1000px; margin: 0 auto;">
      <div class="section-header">
        <div class="section-subtitle">What You Can Load</div>
        <h2 class="section-title">Accepted Tree & Organic Debris</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; margin-top: 30px;">
        <div style="background: #f8fafc; border: 2.5px solid #000; box-shadow: 4px 4px 0px #000; border-radius: 10px; padding: 25px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.3rem; margin-bottom: 15px; color: #16a34a; display: flex; align-items: center; gap: 8px;">
            <span>✓</span> Accepted Tree Debris
          </h3>
          <ul style="list-style: none; padding: 0; margin: 0; line-height: 2;">
            <li>🌲 <strong>Tree Branches & Limbs</strong> (All sizes & lengths)</li>
            <li>🪵 <strong>Tree Trunks & Heavy Logs</strong></li>
            <li>🪵 <strong>Tree Stumps & Root Balls</strong></li>
            <li>🌿 <strong>Shrubs, Bushes & Hedge Trimmings</strong></li>
            <li>🍂 <strong>Leaves, Mulch & Wood Chips</strong></li>
            <li>🌱 <strong>Sod, Dirt, Soil & Landscape Rock</strong></li>
          </ul>
        </div>

        <div style="background: #f8fafc; border: 2.5px solid #000; box-shadow: 4px 4px 0px #000; border-radius: 10px; padding: 25px;">
          <h3 style="font-family: var(--font-heading); font-size: 1.3rem; margin-bottom: 15px; color: #dc2626; display: flex; align-items: center; gap: 8px;">
            <span>✕</span> Prohibited Materials
          </h3>
          <ul style="list-style: none; padding: 0; margin: 0; line-height: 2;">
            <li>🚫 Hazardous chemicals, oil & gasoline</li>
            <li>🚫 Paints, stains & solvents</li>
            <li>🚫 Car tires & heavy automotive batteries</li>
            <li>🚫 Asbestos or toxic insulation</li>
            <li>🚫 Liquid concrete (hardened chunks allowed)</li>
            <li>🚫 Gas-powered lawn equipment with fuel tanks</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ACCORDION SECTION ==================== -->
  <section style="padding: 80px 0; background-color: var(--bg-cream);">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <div class="section-header">
        <div class="section-subtitle">Got Questions?</div>
        <h2 class="section-title">Tree Debris Dumpster FAQs</h2>
      </div>

      <div class="faq-accordion" style="margin-top: 35px;">
        <div class="faq-item" style="background:#fff; border:2.5px solid #000; box-shadow:4px 4px 0px #000; border-radius:8px; margin-bottom:15px; padding:20px;">
          <h3 style="font-family:var(--font-heading); font-size:1.15rem; font-weight:800; margin:0 0 10px 0;">Can I load heavy tree logs and stumps into the dumpster?</h3>
          <p style="color:#475569; margin:0; line-height:1.6;">Yes! Tree trunks, heavy logs, and stumps are fully accepted. Our dumpsters feature heavy-duty rear swing doors so you can roll heavy logs directly into the container without lifting over high sidewalls.</p>
        </div>

        <div class="faq-item" style="background:#fff; border:2.5px solid #000; box-shadow:4px 4px 0px #000; border-radius:8px; margin-bottom:15px; padding:20px;">
          <h3 style="font-family:var(--font-heading); font-size:1.15rem; font-weight:800; margin:0 0 10px 0;">What size dumpster is best for tree trimming and removal?</h3>
          <p style="color:#475569; margin:0; line-height:1.6;">For general yard trimming and branch pruning, a 15-yard dumpster is ideal. For full tree removals, storm damage cleanup, or clearing large property lots, a 20-yard or 30-yard dumpster is recommended.</p>
        </div>

        <div class="faq-item" style="background:#fff; border:2.5px solid #000; box-shadow:4px 4px 0px #000; border-radius:8px; margin-bottom:15px; padding:20px;">
          <h3 style="font-family:var(--font-heading); font-size:1.15rem; font-weight:800; margin:0 0 10px 0;">Will dropping a heavy dumpster damage my driveway?</h3>
          <p style="color:#475569; margin:0; line-height:1.6;">Never. Every Dumpsters 911 roll-off container is equipped with driveway-safe rubber wheels and backed by our 100% Driveway Protection Guarantee to prevent scratches, cracks, or gouges on your asphalt or concrete.</p>
        </div>

        <div class="faq-item" style="background:#fff; border:2.5px solid #000; box-shadow:4px 4px 0px #000; border-radius:8px; margin-bottom:15px; padding:20px;">
          <h3 style="font-family:var(--font-heading); font-size:1.15rem; font-weight:800; margin:0 0 10px 0;">How fast can I get a dumpster delivered?</h3>
          <p style="color:#475569; margin:0; line-height:1.6;">We offer same-day and next-day dumpster delivery across Metro Detroit including Wayne, Oakland, and Macomb counties. Call (248) 479-3667 to lock in your drop-off window.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIAL SLIDER ==================== -->
  <TestimonialSlider />
</BaseLayout>
