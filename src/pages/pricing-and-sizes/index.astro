  <!-- ==================== DETAILED SIZING & TRUCK LOAD CAPACITY TABLE ==================== -->
  <section class="seo-section-cream">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Dumpster Rental Capacity Guide</div>
        <h2 class="section-title">Our Dumpster Dimensions & Pickup Truck Load Equivalents</h2>
        <p style="font-size:1.05rem; color:#475569; max-width:800px; margin:15px auto 0;">
          Not sure which roll-off container size is right for your project? Use our capacity guide to compare volume, dimensions, and weight allowances.
        </p>
      </div>

      <div class="seo-table-wrapper">
        <table class="seo-table">
          <thead>
            <tr>
              <th>Dumpster Size</th>
              <th>Dimensions (L × W × H)</th>
              <th>Pickup Truck Capacity</th>
              <th>Weight Limit</th>
              <th>Best Project Uses</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>15 Yard Dumpster</strong></td>
              <td>17' L × 7' W × 3.5' H</td>
              <td>~6 Pickup Truck Loads</td>
              <td>2 Tons (4,000 lbs)</td>
              <td>Small bathroom/kitchen remodels, garage cleanouts, heavy sod/tile</td>
            </tr>
            <tr>
              <td><strong>20 Yard Dumpster</strong></td>
              <td>18' L × 7' W × 4.5' H</td>
              <td>~8 Pickup Truck Loads</td>
              <td>3 Tons (6,000 lbs)</td>
              <td>Roofing tear-offs, multi-room renovations, flooring removal</td>
            </tr>
            <tr>
              <td><strong>30 Yard Dumpster</strong></td>
              <td>19' L × 7' W × 7' H</td>
              <td>~12 Pickup Truck Loads</td>
              <td>4 Tons (8,000 lbs)</td>
              <td>Whole-home remodels, major estate cleanouts, commercial construction</td>
            </tr>
            <tr>
              <td><strong>40 Yard Dumpster</strong></td>
              <td>20' L × 7' W × 8' H</td>
              <td>~16 Pickup Truck Loads</td>
              <td>5 Tons (10,000 lbs)</td>
              <td>Major commercial demolition, industrial build-outs, large tear-downs</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

