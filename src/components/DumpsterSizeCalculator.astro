---
export interface Props {
  isSection?: boolean;
  title?: string;
  subtitle?: string;
}

const { 
  isSection = false, 
  title = "Instant Dumpster Size Estimator", 
  subtitle = "Select your project type and estimated waste volume to find the right container size for your Metro Detroit driveway:"
} = Astro.props;
---

{isSection ? (
  <section class="calculator-section" style="padding: 70px 0; background-color: var(--bg-cream); border-top: 3px solid #000; border-bottom: 3px solid #000;">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <div class="section-header" style="text-align: center; margin-bottom: 30px;">
        <span class="banner-pill" style="margin-bottom: 12px;">Interactive Sizing Tool</span>
        <h2 class="section-title" style="font-size: 2.2rem; font-weight: 900;">{title}</h2>
        <p style="font-size: 1.05rem; color: #475569; max-width: 700px; margin: 10px auto 0;">{subtitle}</p>
      </div>

      <div class="calculator-card" style="background: #ffffff; border: 3.5px solid #000000; box-shadow: 8px 8px 0px #000000; border-radius: var(--radius-lg); padding: 32px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px;">
          <div>
            <label style="display: block; font-weight: 800; font-size: 0.88rem; text-transform: uppercase; margin-bottom: 8px; color: #1e293b;">1. Select Project Type</label>
            <select class="calc-project-type" style="width: 100%; padding: 14px; border: 2.5px solid #000; border-radius: 8px; font-family: inherit; font-weight: 700; background: #f8fafc; cursor: pointer; font-size: 1rem;">
              <option value="bathroom">Small Bathroom / Garage Purge</option>
              <option value="kitchen" selected>Kitchen Remodel / Flooring</option>
              <option value="roofing">Asphalt Roof Tear-Off</option>
              <option value="basement">Whole Basement / Estate Cleanout</option>
              <option value="demo">Commercial Demolition / Additions</option>
            </select>
          </div>

          <div>
            <label style="display: block; font-weight: 800; font-size: 0.88rem; text-transform: uppercase; margin-bottom: 8px; color: #1e293b;">2. Estimated Debris Volume</label>
            <select class="calc-volume" style="width: 100%; padding: 14px; border: 2.5px solid #000; border-radius: 8px; font-family: inherit; font-weight: 700; background: #f8fafc; cursor: pointer; font-size: 1rem;">
              <option value="6">~5-6 Pickup Loads (Light)</option>
              <option value="8" selected>~7-8 Pickup Loads (Medium)</option>
              <option value="12">~10-12 Pickup Loads (Heavy)</option>
              <option value="16">~15-16 Pickup Loads (X-Large)</option>
            </select>
          </div>
        </div>

        <div class="calc-result" style="background: var(--bg-cream); border: 3px solid #000; border-radius: 12px; padding: 24px; text-align: center;">
          <div style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #64748b; margin-bottom: 4px;">Recommended Container For Your Driveway</div>
          <div class="calc-size-title" style="font-family: var(--font-heading); font-size: 1.8rem; font-weight: 900; color: var(--primary-red); margin-bottom: 8px;">20-Yard Roll-Off Dumpster (#1 Choice)</div>
          <p class="calc-desc" style="font-size: 1.05rem; color: #334155; margin: 0 0 16px; line-height: 1.5;">
            Metro Detroit’s most popular container for kitchen overhauls, roofing tear-offs (up to 30 squares), and floor removals. Includes rubber wheel driveway protection.
          </p>
          <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/book-now/" class="btn btn-red" style="padding: 12px 28px; font-size: 1rem;">Lock In Rate Online →</a>
            <a href="tel:248-479-3667" class="btn btn-green" style="padding: 12px 24px; font-size: 1rem;">Call Moe (248) 479-3667</a>
          </div>
        </div>
      </div>
    </div>
  </section>
) : (
  <div class="calculator-card" style="background: #ffffff; border: 3.5px solid #000000; box-shadow: 8px 8px 0px #000000; border-radius: var(--radius-lg); padding: 30px; margin: 40px 0;">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
      <span style="background: var(--primary-red); color: #fff; font-size: 1.1rem; font-weight: 900; padding: 4px 12px; border-radius: 6px; border: 2px solid #000;">TOOL</span>
      <h3 style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 800; color: var(--text-dark); margin: 0;">
        {title}
      </h3>
    </div>
    
    <p style="font-size: 0.95rem; color: #475569; margin-bottom: 20px; line-height: 1.4;">
      {subtitle}
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-bottom: 20px;">
      <div>
        <label style="display: block; font-weight: 800; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 6px; color: #1e293b;">Project Type</label>
        <select class="calc-project-type" style="width: 100%; padding: 12px; border: 2.5px solid #000; border-radius: 8px; font-family: inherit; font-weight: 700; background: #f8fafc; cursor: pointer;">
          <option value="bathroom">Small Bathroom / Garage Purge</option>
          <option value="kitchen" selected>Kitchen Remodel / Flooring</option>
          <option value="roofing">Asphalt Roof Tear-Off</option>
          <option value="basement">Whole Basement / Estate Cleanout</option>
          <option value="demo">Commercial Demolition / Additions</option>
        </select>
      </div>

      <div>
        <label style="display: block; font-weight: 800; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 6px; color: #1e293b;">Debris Volume</label>
        <select class="calc-volume" style="width: 100%; padding: 12px; border: 2.5px solid #000; border-radius: 8px; font-family: inherit; font-weight: 700; background: #f8fafc; cursor: pointer;">
          <option value="6">~5-6 Pickup Loads (Light)</option>
          <option value="8" selected>~7-8 Pickup Loads (Medium)</option>
          <option value="12">~10-12 Pickup Loads (Heavy)</option>
          <option value="16">~15-16 Pickup Loads (X-Large)</option>
        </select>
      </div>
    </div>

    <div class="calc-result" style="background: var(--bg-cream); border: 2.5px solid #000; border-radius: 10px; padding: 20px; text-align: center;">
      <div style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #64748b; margin-bottom: 4px;">Recommended Container</div>
      <div class="calc-size-title" style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 900; color: var(--primary-red); margin-bottom: 6px;">20-Yard Roll-Off Dumpster</div>
      <p class="calc-desc" style="font-size: 0.95rem; color: #334155; margin: 0 0 14px; line-height: 1.4;">
        Perfect for kitchen overhauls and multi-room cleanouts in Oakland & Macomb counties. Includes rubber wheel driveway protection.
      </p>
      <a href="/book-now/" class="btn btn-red" style="padding: 10px 24px; font-size: 0.95rem; display: inline-block;">Lock In Rate Online →</a>
    </div>
  </div>
)}

<script is:inline>
  (function setupAllCalculators() {
    document.querySelectorAll('.calculator-card, .calculator-section').forEach((card) => {
      const projSelect = card.querySelector('.calc-project-type');
      const volSelect = card.querySelector('.calc-volume');
      const titleEl = card.querySelector('.calc-size-title');
      const descEl = card.querySelector('.calc-desc');

      if (!projSelect || !volSelect || !titleEl || !descEl) return;

      function updateResult() {
        const proj = projSelect.value;
        const vol = volSelect.value;

        if (proj === 'bathroom' || vol === '6') {
          titleEl.textContent = '15-Yard Roll-Off Dumpster';
          descEl.textContent = 'Ideal for tight driveways in Livonia & Dearborn. Low 3.5ft walls allow easy loading over the sides.';
        } else if (proj === 'kitchen' || proj === 'roofing' || vol === '8') {
          titleEl.textContent = '20-Yard Roll-Off Dumpster (#1 Choice)';
          descEl.textContent = 'Metro Detroit’s most popular container for kitchen overhauls, roofing tear-offs (up to 30 squares), and floor removals.';
        } else if (proj === 'basement' || vol === '12') {
          titleEl.textContent = '30-Yard Roll-Off Dumpster';
          descEl.textContent = 'Best for whole-house estate cleanouts, multi-room drywall guts, and large storm debris. High 7ft walls swallow bulky items.';
        } else {
          titleEl.textContent = '40-Yard Heavy Commercial Container';
          descEl.textContent = 'Designed for major commercial build-outs, warehouse liquidations, and heavy construction demolition across Metro Detroit.';
        }
      }

      projSelect.addEventListener('change', updateResult);
      volSelect.addEventListener('change', updateResult);
    });
  })();
</script>
