---
const reviews = [
  {
    name: "Dawn Wegehaupt",
    quote: "Dumpsters 911 was fantastic. Moe answered any question I had, when I needed to exchange a dumpster I got it the next day no problem. What can I say besides wonderful customer service, notifications were spot on. 10 no 20 stars. I will (and have) recommend them."
  },
  {
    name: "Kim McFarland",
    quote: "Great Service, delivered and picked up as promised and a Great Rate! Highly Recommend!"
  },
  {
    name: "Cynthia Woods",
    quote: "They delivered as scheduled, very friendly and professional. My street had many cars on it when they picked up the dumpster, he did so promptly and with ease. I would definitely hire them again!"
  },
  {
    name: "Ron Moses",
    quote: "Quick delivery and very fair pricing would use again"
  },
  {
    name: "Robert Guthrie",
    quote: "Great experience had a full house clean up and got the dumpsters on time without any extra problems and were more than helpful with getting a second dumpster"
  },
  {
    name: "Siddique Khatri",
    quote: "Mr. Sarsour provided prompt, professional and courteous service. I needed his service for a recent renovation job. I highly recommend him for dumpster services. Thank you."
  },
  {
    name: "David Lockwood",
    quote: "This company has gone the extra mile to help me and my company. I strongly recommend them I would not think of using another company. They are the best"
  },
  {
    name: "RS",
    quote: "They delivered the dumpster on time and picked it up on the same day we called to ask them to pick it up. Will definitely do business with them again!"
  },
  {
    name: "David Milo",
    quote: "Dumpsters 911 is the best, I wish there were 10 stars! On short notice they supplied the dumpster I requested for a house clean out and went above and beyond to remove it before closing."
  },
  {
    name: "Mohammed Abdrabboh",
    quote: "I had a short window of time to work with and some last minute requests. Everything was accommodated, I highly recommend them to anyone if you’re considering it."
  }
];

const allReviews = [...reviews, ...reviews];
---

<section class="testimonials-section" style="overflow: hidden; padding-bottom: 40px;">
  <div class="container">
    <div class="section-header">
      <div class="section-subtitle">Don't Take Our Word</div>
      <h2 class="section-title">What Our Customers Say</h2>
    </div>
  </div>

  <div class="slider-container" style="overflow: hidden; width: 100vw; max-width: 100%; padding: 15px 0 25px 0;">
    <div class="testimonials-slider marquee-track" id="testimonialsSlider">
      {allReviews.map((rev) => (
        <div class="testimonial-card">
          <div>
            <div class="testimonial-header">
              <div class="stars">★★★★★</div>
              <div class="google-icon">
                <img src="/assets/images/icons8-google-48.png" alt="Google Review">
              </div>
            </div>
            <p class="testimonial-quote">
              "{rev.quote}"
            </p>
          </div>
          <div class="testimonial-author">{rev.name}</div>
        </div>
      ))}
    </div>
  </div>
</section>
